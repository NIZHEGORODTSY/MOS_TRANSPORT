{
  "openapi": "3.1.0",
  "info": {
    "title": "Bus Delay Predictor",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/set_context": {
      "post": {
        "summary": "Set Context",
        "operationId": "set_context_set_context_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetContextRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetContextResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/predict": {
      "post": {
        "summary": "Predict",
        "operationId": "predict_predict_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "has_context": {
            "type": "boolean",
            "title": "Has Context"
          },
          "n_vehicles": {
            "type": "integer",
            "title": "N Vehicles"
          },
          "model_dir": {
            "type": "string",
            "title": "Model Dir"
          }
        },
        "type": "object",
        "required": [
          "status",
          "has_context",
          "n_vehicles",
          "model_dir"
        ],
        "title": "HealthResponse"
      },
      "PointRow": {
        "properties": {
          "sample_id": {
            "type": "string",
            "title": "Sample Id"
          },
          "tr_id": {
            "title": "Tr Id"
          },
          "T": {
            "type": "string",
            "title": "T"
          },
          "target_stop_id": {
            "title": "Target Stop Id"
          },
          "target_time_begin": {
            "type": "string",
            "title": "Target Time Begin"
          },
          "cur_dev_s": {
            "type": "number",
            "title": "Cur Dev S"
          }
        },
        "type": "object",
        "required": [
          "sample_id",
          "tr_id",
          "T",
          "target_stop_id",
          "target_time_begin",
          "cur_dev_s"
        ],
        "title": "PointRow"
      },
      "PredictRequest": {
        "properties": {
          "points": {
            "items": {
              "$ref": "#/components/schemas/PointRow"
            },
            "type": "array",
            "minItems": 1,
            "title": "Points"
          }
        },
        "type": "object",
        "required": [
          "points"
        ],
        "title": "PredictRequest"
      },
      "PredictResponse": {
        "properties": {
          "sample_id": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sample Id"
          },
          "prediction": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Prediction"
          }
        },
        "type": "object",
        "required": [
          "sample_id",
          "prediction"
        ],
        "title": "PredictResponse"
      },
      "ScheduleRow": {
        "properties": {
          "tt_action_item_id": {
            "title": "Tt Action Item Id"
          },
          "tr_id": {
            "title": "Tr Id"
          },
          "time_begin": {
            "type": "string",
            "title": "Time Begin"
          },
          "geom": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Geom"
          },
          "lon": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lon"
          },
          "lat": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lat"
          },
          "building_address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Building Address",
            "default": ""
          },
          "manual_fill": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Manual Fill",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "tt_action_item_id",
          "tr_id",
          "time_begin"
        ],
        "title": "ScheduleRow"
      },
      "SetContextRequest": {
        "properties": {
          "traffic": {
            "items": {
              "$ref": "#/components/schemas/TrafficRow"
            },
            "type": "array",
            "minItems": 1,
            "title": "Traffic"
          },
          "schedule": {
            "items": {
              "$ref": "#/components/schemas/ScheduleRow"
            },
            "type": "array",
            "minItems": 1,
            "title": "Schedule"
          }
        },
        "type": "object",
        "required": [
          "traffic",
          "schedule"
        ],
        "title": "SetContextRequest"
      },
      "SetContextResponse": {
        "properties": {
          "n_vehicles": {
            "type": "integer",
            "title": "N Vehicles"
          },
          "elapsed_sec": {
            "type": "number",
            "title": "Elapsed Sec"
          }
        },
        "type": "object",
        "required": [
          "n_vehicles",
          "elapsed_sec"
        ],
        "title": "SetContextResponse"
      },
      "TrafficRow": {
        "properties": {
          "tr_id": {
            "title": "Tr Id"
          },
          "event_time": {
            "type": "string",
            "title": "Event Time"
          },
          "receive_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Receive Time"
          },
          "lon": {
            "type": "number",
            "title": "Lon"
          },
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "speed": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Speed",
            "default": 0.0
          },
          "heading": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heading",
            "default": 0.0
          },
          "location_valid": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Location Valid",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "tr_id",
          "event_time",
          "lon",
          "lat"
        ],
        "title": "TrafficRow"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}