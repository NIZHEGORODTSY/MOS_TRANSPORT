# Copy to .env next to docker-compose.yml.
# Public port of the dashboard (80 on the server, if it is open to the internet)
WEB_PORT=8080
# Replay speed of the historical NDTP stream: 1 = real time, 30 = one hour in two minutes
REPLAY_SPEED=1
# Host-only (127.0.0.1) ports of the backend: HTTP API/Swagger and NDTP for an external stream source
API_PORT=8000
NDTP_PORT=9201
