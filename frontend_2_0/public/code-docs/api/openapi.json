        "description": "Используется healthcheck-ом контейнера.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Api Health Get"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
